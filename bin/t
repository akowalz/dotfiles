#!/usr/bin/env bash
#
# t - describe a shell command in plain English, have Claude write it, then run it.
#
#   t list the files in this dir by increasing size
#   t -y fetch the raw html from google.com     # skip confirmation
#
# The shell parses the request before t sees it. zshrc aliases t to noglob t, so ? and *
# are fine, but quote a request containing an apostrophe, $, `backticks` or #:
#   t "find files that don't end in .txt"
#
# Model can be overridden with T_MODEL (default: opus).

set -o pipefail

usage() {
  echo "usage: t [-y] <description of what you want to do>" >&2
  exit 1
}

confirm=1
if [ "$1" = "-y" ]; then
  confirm=0
  shift
fi
[ $# -eq 0 ] && usage

if ! command -v claude >/dev/null 2>&1; then
  echo "t: claude CLI not found on PATH" >&2
  exit 1
fi

system_prompt="You translate a plain-English request into a single shell command.
Environment: $(uname -sm), shell: bash, working directory: $PWD.
Put the command, on one line with no markdown or code fences, in \"command\".
Put one short plain-English sentence (under 15 words) saying what it does in \"description\".
Chain with && or | if several steps are needed. Prefer tools that ship with the OS.
Don't hide errors (no 2>/dev/null) unless asked to, so a failure shows why it failed.
If the request cannot be done safely as a command, make the command: echo \"<short reason>\""

# The command comes back as a JSON field rather than free text,
# so markdown (code fences, `backticks`, a "$ " prompt) can't leak into it.
schema='{"type":"object","properties":{"command":{"type":"string"},"description":{"type":"string"}},"required":["command","description"],"additionalProperties":false}'

# Claude Code-style spinner on stderr while claude runs.
spin() {
  local frames=(· ✢ ✳ ✶ ✻ ✽ ✻ ✶ ✳ ✢) i=0
  printf '\033[?25l' >&2 # hide the cursor
  while :; do
    printf '\r\033[33m%s Working…\033[0m' "${frames[i++ % ${#frames[@]}]}" >&2 # theme yellow
    sleep 0.12
  done
}
stop_spin() {
  [ -n "$spinner" ] || return 0
  kill "$spinner" 2>/dev/null
  wait "$spinner" 2>/dev/null
  spinner=
  printf '\r\033[K\033[?25h' >&2 # clear the line, show the cursor
}
spinner=
trap stop_spin EXIT
trap 'stop_spin; exit 130' INT
if [ -t 2 ]; then
  spin &
  spinner=$!
fi

out=$(claude -p --model "${T_MODEL:-opus}" --tools "" --output-format json \
  --json-schema "$schema" --system-prompt "$system_prompt" "$*" </dev/null)
status=$?
stop_spin
cmd=$(printf '%s' "$out" | jq -r '.structured_output.command // empty' 2>/dev/null)
if [ $status -ne 0 ] || [ -z "$cmd" ]; then
  echo "t: claude failed: $(printf '%s' "$out" | jq -r '.result // empty' 2>/dev/null)" >&2
  exit 1
fi

description=$(printf '%s' "$out" | jq -r '.structured_output.description // empty' 2>/dev/null)

printf '\033[1;36m$ %s\033[0m\n' "$cmd" >&2
[ -n "$description" ] && printf '  %s\n' "$description" >&2

if [ $confirm -eq 1 ]; then
  # one keypress, no Enter needed after it: Enter (or y) runs, e edits, anything else cancels
  printf '\033[2m↵ run · e edit · any other key cancels\033[0m' >&2
  IFS= read -rsn1 answer </dev/tty
  printf '\r\033[K' >&2
  case "$answer" in
    ""|y|Y) ;;
    e|E)
      if [ "${BASH_VERSINFO[0]}" -ge 4 ]; then
        read -r -e -i "$cmd" -p '$ ' cmd </dev/tty
      else
        read -r -e -p '$ ' cmd </dev/tty
      fi
      [ -z "$cmd" ] && exit 1
      ;;
    *) exit 1 ;;
  esac
fi

eval "$cmd"
