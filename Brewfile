# vim: ft=ruby

# Shell
brew "zsh-autosuggestions"
brew "direnv"
brew "fd"    # file finder for fzf (zshrc)
brew "watch" # rerun a command every few seconds
brew "glow"  # render markdown notes in the terminal (md in zshrc)

# git
brew "gh"   # used by Claude Code
brew "fzf"  # git select, zsh key bindings
brew "git-delta" # git pager (gitconfig)
brew "diffnav" # diff viewer with a file tree (gv in zshrc)

brew "tmux"

# vim: language servers for its LSP plugin (vimrc)
brew "typescript" # TypeScript 7's own server, outside projects with an older TypeScript
brew "typescript-language-server" # for projects on TypeScript 6 and older, and Vue's <script>
brew "vue-language-server" # vimrc hands its TypeScript plugin to the server above
brew "pyright"
brew "ruby-lsp"

cask "rectangle"
